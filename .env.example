# KitAi Environment Configuration Template
# Copy this file to .env and configure your keys

# === Groq Cloud Inference (Fast & Free Tier Available) ===
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended Models
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# === Local Ollama Fallback (Optional) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# === Database Storage ===
DATABASE_URL=sqlite+aiosqlite:///./data/studybrain.db

# === Microsoft Edge-TTS Neural Voice Engine ===
TTS_ENGINE=edge
TTS_LANGUAGE=en
TTS_VOICE=en-US-AriaNeural

# === Application Server Configuration ===
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
